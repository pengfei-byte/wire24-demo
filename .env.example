POPVID_API_KEY=pk_live_your_key_here
POPVID_BASE_URL=https://popvid.ai/api/public/v1
PORT=8787
MAX_CONCURRENT_SESSIONS=3
CONNECT_LIMIT_PER_IP=12
# Public HTTPS origin that can serve /anchor.jpg (576x768). Required for PopVid to clone the face.
# Localhost will not work — PopVid fetches the image from its own servers.
# PUBLIC_BASE_URL=https://your-app.onrender.com
# SEED_IMAGE_URL=https://your-cdn.example.com/anchor.jpg
